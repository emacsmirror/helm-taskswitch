{
  "manifest_version": 3,
  "name": "helm-taskswitch tabs",
  "short_name": "helm-taskswitch",
  "description": "Sends your tabs to Emacs helm-taskswitch over a WebSocket on 127.0.0.1, and lets Emacs switch to them.",
  "version": "0.4",
  "author": "Brian Caruso",

  "key": "",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["tabs", "alarms", "storage"]
}
